{
  "name": "switchboard",
  "productName": "Switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "A local control panel for development workspaces",
  "main": "src/main/index.js",
  "scripts": {
    "prestart": "npm run build:diagrams",
    "start": "electron .",
    "install:desktop": "node scripts/install-desktop.js",
    "postinstall": "node scripts/fix-node-pty.js",
    "check": "node scripts/check.js",
    "test:publish": "node --test scripts/test-publish.js",
    "package": "node scripts/package.js",
    "test:config": "node --test scripts/test-config.js scripts/test-workspaces.js",
    "test:editor": "node --test scripts/test-editor.js",
    "test:notes": "node --test scripts/test-notes.js scripts/test-noteedit.js",
    "build:diagrams": "node scripts/build-diagrams.js",
    "check:diagrams": "tsc -p src/diagrams/tsconfig.json",
    "test:diagrams": "node --test scripts/test-diagrams.js scripts/test-answer.js scripts/test-flow-layout.js scripts/test-condense.js scripts/test-images.js scripts/test-image-search.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toast": "1.2.15",
    "@remixicon/react": "4.9.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xyflow/react": "12.11.3",
    "clsx": "2.1.1",
    "electron": "44.4.2",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
